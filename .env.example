# FalkorDB connection (docker compose maps the container's 6379 to 6390 on the host)
FALKORDB_HOST=localhost
FALKORDB_PORT=6390
FALKORDB_USERNAME=
FALKORDB_PASSWORD=

# LLM (optional). Without a key the app runs in a clearly labelled MOCK MODE.
# OpenRouter has free ":free" models (20 requests/min, 50/day without purchased credits).
# An OpenRouter key wins over an Anthropic key when both are set.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Live LLM requests per UTC day (default: 35 when PUBLIC_DEMO=true, otherwise unlimited)
# LLM_DAILY_BUDGET=35

# Guard tuning
GUARD_LOCKDOWN_THRESHOLD=40
